[run]
source = .
# Leaves out third-party code, generated migrations, the tests themselves and entry-point scripts
omit =
    venv/*
    */migrations/*
    */tests.py
    manage.py
    rakau_backend/asgi.py
    rakau_backend/wsgi.py
    seeding/__main__.py

[report]
skip_empty = true
show_missing = true
