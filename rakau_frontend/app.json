{
  "expo": {
    "name": "rakau_frontend",
    "slug": "rakau_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/rakau-badge-green-transparent.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2E1B",
        "foregroundImage": "./assets/rakau-badge-green-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/rakau-badge-green-transparent.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
